# Mizan frontend — environment template.
# Copy to .env.local for local dev:   cp .env.example .env.local
# Only NEXT_PUBLIC_* vars are exposed to the browser. Never put secrets here.

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Paddle (checkout overlay via Paddle.js) ────────────────────────────────────
# Client-side token (Paddle dashboard → Authentication → Client-side tokens).
# Safe to expose — it can only open checkouts, not read account data.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" while testing, "production" when live (must match the backend).
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Price IDs (pri_…) for each plan + billing cycle — created in the Paddle catalog.
# These MUST match the backend PADDLE_PRICE_* values.
NEXT_PUBLIC_PADDLE_PRICE_PLUS_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_PLUS_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=
