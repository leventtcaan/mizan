# Clarifin — environment template.
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored and must NEVER be committed. This file (.env.example) IS
# committed — it documents every variable without exposing any secret.

# ── Required ──────────────────────────────────────────────────────────────────
# SECRET_KEY signs JWTs. It has NO default — the backend fails to start if unset,
# so it must be provided. Generate one with:  openssl rand -hex 32
SECRET_KEY=change-me-run-openssl-rand-hex-32

# ── Database ──────────────────────────────────────────────────────────────────
# Async SQLAlchemy URL. Default targets the docker-compose "postgres" service.
# Running the backend OUTSIDE Docker? Use:
#   postgresql+asyncpg://mizan:password@localhost:5434/mizan
DATABASE_URL=postgresql+asyncpg://mizan:password@postgres:5432/mizan

# ── Redis (rate limiter) ──────────────────────────────────────────────────────
# Backs the rate limiter so limits survive restarts + work across instances.
# "redis" host works inside docker-compose. Empty/unreachable → in-memory fallback.
REDIS_URL=redis://redis:6379/0

# ── LLM providers (empty disables AI features; at least one recommended) ───────
# Primary: DeepSeek (OpenAI-compatible). Fallback: OpenAI.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ── Email (Resend) — optional; empty disables outbound email ──────────────────
RESEND_API_KEY=
# From-address for outbound mail. Default is Resend's shared sandbox sender
# (works without domain verification). Production must use a verified-domain sender.
RESEND_FROM_EMAIL=Clarifin <onboarding@resend.dev>

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Allowed CORS origin (the frontend URL).
FRONTEND_URL=http://localhost:3000

# ── JWT (optional — sensible defaults shown) ──────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Paddle — backend (payments; Merchant of Record) ────────────────────────────
# "sandbox" for testing, "production" when live.
PADDLE_ENVIRONMENT=sandbox
# Webhook signing secret (Paddle → Notifications). Empty → webhook rejects everything.
PADDLE_WEBHOOK_SECRET=
# Server-side API key (Paddle → Authentication) — needed to cancel a subscription.
PADDLE_API_KEY=
# Price IDs (pri_…) — webhook maps a subscription's price back to a plan.
PADDLE_PRICE_PLUS_MONTHLY=
PADDLE_PRICE_PLUS_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=

# ── Paddle — frontend (Paddle.js checkout overlay) ─────────────────────────────
# Client-side token (Paddle → Authentication → Client-side tokens). Safe to expose.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Must match PADDLE_ENVIRONMENT above ("sandbox" | "production").
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# The SAME price IDs as the backend, exposed to the checkout overlay.
NEXT_PUBLIC_PADDLE_PRICE_PLUS_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_PLUS_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=
